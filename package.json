{
  "name": "codeatlas-architecture",
  "displayName": "CodeAtlas Architecture: Code Graph & Lens",
  "description": "Interactive call graph and dependency visualization for Python, TypeScript, and JavaScript with static call tracing and unused code detection.",
  "version": "0.1.3",
  "publisher": "voidric",
  "repository": {
    "type": "git",
    "url": "https://github.com/voidric/CodeAtlas-Architecture.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:codeatlas.mainView",
    "onCommand:codeatlas.refresh",
    "onCommand:codeatlas.showInGraph",
    "onCommand:codeatlas.openWebviewPanel",
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeatlas-container",
          "title": "CodeAtlas Architecture",
          "icon": "$(type-hierarchy)"
        }
      ]
    },
    "views": {
      "codeatlas-container": [
        {
          "type": "webview",
          "id": "codeatlas.mainView",
          "name": "Architecture Outline"
        }
      ]
    },
    "commands": [
      {
        "command": "codeatlas.refresh",
        "title": "CodeAtlas: Rescan Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "codeatlas.showInGraph",
        "title": "CodeAtlas: Focus Current Symbol in Graph",
        "icon": "$(symbol-class)"
      },
      {
        "command": "codeatlas.openWebviewPanel",
        "title": "CodeAtlas: Open Architecture Graph in Tab",
        "icon": "$(split-horizontal)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeatlas.showInGraph",
          "when": "editorLangId == python || editorLangId == typescript || editorLangId == javascript || editorLangId == typescriptreact || editorLangId == javascriptreact",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "codeatlas.refresh",
          "when": "view == codeatlas.mainView",
          "group": "navigation@1"
        },
        {
          "command": "codeatlas.openWebviewPanel",
          "when": "view == codeatlas.mainView",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "CodeAtlas Architecture",
      "properties": {
        "codeatlas.scanOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan workspace and build call graph on startup"
        },
        "codeatlas.cursorDebounceMs": {
          "type": "number",
          "default": 250,
          "description": "Debounce delay (ms) for editor cursor tracking in graph"
        },
        "codeatlas.ignoreDirs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".venv",
            "venv",
            "__pycache__",
            ".git",
            "site-packages",
            "node_modules",
            "dist",
            "out",
            "build"
          ],
          "description": "Directory patterns to ignore during workspace scanning"
        },
        "codeatlas.llmEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434/v1",
          "description": "Base URL for LLM API (OpenAI-compatible or local Ollama, default http://127.0.0.1:11434/v1)"
        },
        "codeatlas.apiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for authorization (leave empty for unauthenticated local services)"
        },
        "codeatlas.selectedModel": {
          "type": "string",
          "default": "qwen2.5-coder:7b",
          "description": "Model identifier for architecture analysis (e.g. qwen2.5-coder:7b, deepseek-chat, gpt-4o)"
        },
        "codeatlas.enableIncrementalCache": {
          "type": "boolean",
          "default": true,
          "description": "Enable MD5 content-hash incremental caching for instant startup"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node out/test/testV035.js",
    "package": "npx @vscode/vsce package --readme-path docs/MARKETPLACE_README.md --out releases/"
  },
  "dependencies": {
    "graphology": "^0.25.4",
    "graphology-shortest-path": "^2.1.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0"
  }
}
